{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galope",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "galope",
      "database_id": "4fff9503-b366-4c8c-831a-1a3d0bf33fff",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "galope-media"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "BOLD_MODE": "sandbox",
    "GOOGLE_CLIENT_ID": "89468337219-9iruu38h1orohhpkr559umh35gk072be.apps.googleusercontent.com",
    "ADMIN_EMAILS": "galopegalope44@gmail.com",
    "SESSION_TTL_HOURS": "12"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
